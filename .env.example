# Next.js server (never commit real values)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_MODE=local
CONTENT_READ_SECRET=
REVALIDATION_SECRET=
# R2 S3 credentials, scoped to the private staging bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=portfolio-z-staging-media
# Cloudflare Access protects ALL staging requests
CF_ACCESS_ISSUER=
CF_ACCESS_AUD=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Also set on Convex: BETTER_AUTH_SECRET, SITE_URL, RESEND_API_KEY,
# EMAIL_FROM, CONTENT_READ_SECRET, REVALIDATION_SECRET, SITE_MODE,
# REVALIDATION_URL, and optional CF_ACCESS_CLIENT_ID/CF_ACCESS_CLIENT_SECRET.
RESEND_API_KEY=
EMAIL_FROM=
